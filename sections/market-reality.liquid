{% render 'focusable-styles' %}
{% render 'market-reality', section: section %}

{% schema %}
{
  "name": "t:focusable.market_reality.name",
  "class": "fc-section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:focusable.common.eyebrow",
      "default": "// Market Reality"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:focusable.common.heading",
      "default": "The EAA Grace Period Has Ended"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:focusable.common.lede",
      "default": "The EAA is now an active law. Under Directive 2019/882, if your storefront isn't verified, your revenue is exposed to immediate legal and audit risks."
    },
    {
      "type": "select",
      "id": "surface",
      "label": "t:focusable.common.surface",
      "options": [
        { "value": "light", "label": "t:focusable.common.surface_light" },
        { "value": "tint", "label": "t:focusable.common.surface_tint" }
      ],
      "default": "tint"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "t:focusable.market_reality.stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "t:focusable.market_reality.stat_value",
          "default": "€1,000,000"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:focusable.common.title",
          "default": "Regulatory Enforcement"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "t:focusable.common.body",
          "default": "National authorities cap administrative penalties at this ceiling for severe EAA infractions."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:focusable.market_reality.name",
      "category": "t:focusable.common.category",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "Ley 11/2023",
            "title": "Market Withdrawal Power",
            "body": "Spanish regulators can legally mandate the immediate suspension or complete withdrawal of non-compliant digital services."
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "€1,000,000",
            "title": "Regulatory Enforcement",
            "body": "National authorities cap administrative penalties at this ceiling for severe EAA infractions."
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "15%",
            "title": "Instant Cart Abandonment",
            "body": "This segment of the EU market relies on accessible interfaces. A broken checkout loop equals permanently lost revenue."
          }
        }
      ]
    }
  ]
}
{% endschema %}
