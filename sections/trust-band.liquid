{% render 'focusable-styles' %}
{% render 'trust-band', section: section %}

{% schema %}
{
  "name": "t:focusable.trust_band.name",
  "class": "fc-section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:focusable.common.heading",
      "default": "Engineered for Modern E-commerce Stacks"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "t:focusable.trust_band.logo",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:focusable.trust_band.logo_label",
          "info": "t:focusable.trust_band.logo_label_info",
          "default": "Shopify"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:focusable.trust_band.logo_image",
          "info": "t:focusable.trust_band.logo_image_info"
        },
        {
          "type": "url",
          "id": "url",
          "label": "t:focusable.trust_band.logo_url"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "t:focusable.trust_band.name",
      "category": "t:focusable.common.category",
      "blocks": [
        { "type": "logo", "settings": { "label": "Shopify" } },
        { "type": "logo", "settings": { "label": "Shopify Plus" } },
        { "type": "logo", "settings": { "label": "React" } },
        { "type": "logo", "settings": { "label": "Next.js" } },
        { "type": "logo", "settings": { "label": "Stripe" } }
      ]
    }
  ]
}
{% endschema %}
