{% render 'focusable-styles' %}
{% render 'authority-teardowns', section: section %}

{% schema %}
{
  "name": "t:focusable.authority.name",
  "class": "fc-section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:focusable.common.eyebrow",
      "default": "// Expertise in Action"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:focusable.common.heading",
      "default": "Industry Talks & Keynotes"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:focusable.common.lede",
      "default": "Watch our founders share field-tested accessibility insights at major European tech summits."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "talk",
      "name": "t:focusable.authority.talk",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:focusable.common.title",
          "default": "There is always a way to fix Accessibility"
        },
        {
          "type": "text",
          "id": "event",
          "label": "t:focusable.authority.event",
          "default": "EpicHey! Conference 2024"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "t:focusable.authority.thumbnail",
          "info": "t:focusable.authority.thumbnail_info"
        },
        {
          "type": "url",
          "id": "url",
          "label": "t:focusable.authority.url"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:focusable.authority.link_label",
          "default": "Watch the talk"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:focusable.authority.name",
      "category": "t:focusable.common.category",
      "blocks": [
        { "type": "talk", "settings": { "title": "Android Accessibility: Do or Do", "event": "DevFest Berlin 2023", "link_label": "Watch the talk" } },
        { "type": "talk", "settings": { "title": "There is always a way to fix Accessibility", "event": "EpicHey! Conference 2024", "link_label": "Watch the talk" } },
        { "type": "talk", "settings": { "title": "a11y Testing Is Broken: How Lighthouse and Axe Fail in Real Projects", "event": "JSNation 2025", "link_label": "Read the keynotes" } }
      ]
    }
  ]
}
{% endschema %}
