{% render 'focusable-styles' %}

<script
  src="{{ 'risk-calculator.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'risk-calculator', section: section %}

{% schema %}
{
  "name": "t:focusable.calculator.name",
  "class": "fc-section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:focusable.common.content_header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:focusable.common.eyebrow",
      "default": "// Financial Impact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:focusable.common.heading",
      "default": "EAA Risk Exposure Assessment"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:focusable.common.lede",
      "default": "Model your exposure across both enforcement ceilings above — adjust your annual EU revenue and platform complexity to see the estimate update."
    },
    {
      "type": "header",
      "content": "t:focusable.calculator.revenue_header"
    },
    {
      "type": "text",
      "id": "revenue_label",
      "label": "t:focusable.common.label",
      "default": "Annual EU Revenue"
    },
    {
      "type": "number",
      "id": "revenue_min",
      "label": "t:focusable.calculator.min",
      "default": 500000
    },
    {
      "type": "number",
      "id": "revenue_max",
      "label": "t:focusable.calculator.max",
      "default": 50000000
    },
    {
      "type": "number",
      "id": "revenue_step",
      "label": "t:focusable.calculator.step",
      "default": 500000
    },
    {
      "type": "number",
      "id": "revenue_default",
      "label": "t:focusable.calculator.default",
      "default": 5000000
    },
    {
      "type": "header",
      "content": "t:focusable.calculator.pages_header"
    },
    {
      "type": "text",
      "id": "pages_label",
      "label": "t:focusable.common.label",
      "default": "Platform Complexity"
    },
    {
      "type": "text",
      "id": "pages_unit",
      "label": "t:focusable.calculator.unit",
      "default": "pages"
    },
    {
      "type": "number",
      "id": "pages_min",
      "label": "t:focusable.calculator.min",
      "default": 5
    },
    {
      "type": "number",
      "id": "pages_max",
      "label": "t:focusable.calculator.max",
      "default": 300
    },
    {
      "type": "number",
      "id": "pages_step",
      "label": "t:focusable.calculator.step",
      "default": 5
    },
    {
      "type": "number",
      "id": "pages_default",
      "label": "t:focusable.calculator.default",
      "default": 60
    },
    {
      "type": "header",
      "content": "t:focusable.calculator.markets_header"
    },
    {
      "type": "text",
      "id": "markets_label",
      "label": "t:focusable.common.label",
      "default": "EU Jurisdictions"
    },
    {
      "type": "text",
      "id": "markets_unit",
      "label": "t:focusable.calculator.unit",
      "default": "markets"
    },
    {
      "type": "number",
      "id": "markets_min",
      "label": "t:focusable.calculator.min",
      "default": 1
    },
    {
      "type": "number",
      "id": "markets_max",
      "label": "t:focusable.calculator.max",
      "default": 27
    },
    {
      "type": "number",
      "id": "markets_step",
      "label": "t:focusable.calculator.step",
      "default": 1
    },
    {
      "type": "number",
      "id": "markets_default",
      "label": "t:focusable.calculator.default",
      "default": 3
    },
    {
      "type": "header",
      "content": "t:focusable.calculator.posture_header"
    },
    {
      "type": "text",
      "id": "posture_label",
      "label": "t:focusable.common.label",
      "default": "Compliance Posture"
    },
    {
      "type": "header",
      "content": "t:focusable.calculator.formula_header"
    },
    {
      "type": "range",
      "id": "fine_pct_min",
      "label": "t:focusable.calculator.fine_pct_min",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "%",
      "default": 1
    },
    {
      "type": "range",
      "id": "fine_pct_max",
      "label": "t:focusable.calculator.fine_pct_max",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "%",
      "default": 5
    },
    {
      "type": "number",
      "id": "penalty_floor",
      "label": "t:focusable.calculator.penalty_floor",
      "default": 50000
    },
    {
      "type": "number",
      "id": "penalty_ceiling",
      "label": "t:focusable.calculator.penalty_ceiling",
      "default": 1000000
    },
    {
      "type": "range",
      "id": "cross_border_max",
      "label": "t:focusable.calculator.cross_border_max",
      "info": "t:focusable.calculator.cross_border_max_info",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "number",
      "id": "mitigation_cost",
      "label": "t:focusable.calculator.mitigation_cost",
      "default": 500
    },
    {
      "type": "header",
      "content": "t:focusable.calculator.outputs_header"
    },
    {
      "type": "text",
      "id": "fine_label",
      "label": "t:focusable.calculator.fine_label",
      "default": "Potential Fine · % of Turnover"
    },
    {
      "type": "text",
      "id": "penalty_label",
      "label": "t:focusable.calculator.penalty_label",
      "default": "Administrative Penalty Estimate"
    },
    {
      "type": "checkbox",
      "id": "show_roi",
      "label": "t:focusable.calculator.show_roi",
      "default": true
    },
    {
      "type": "header",
      "content": "t:focusable.common.cta_header"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:focusable.common.primary_label",
      "default": "Mitigate this risk for €500"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:focusable.common.primary_url"
    },
    {
      "type": "text",
      "id": "cta_note",
      "label": "t:focusable.common.primary_note",
      "default": "48h · No calls."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "posture",
      "name": "t:focusable.calculator.posture",
      "settings": [
        {
          "type": "text",
          "id": "short_label",
          "label": "t:focusable.calculator.posture_short_label",
          "default": "None"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:focusable.calculator.posture_label",
          "default": "None / No Statement"
        },
        {
          "type": "range",
          "id": "discount",
          "label": "t:focusable.calculator.posture_discount",
          "info": "t:focusable.calculator.posture_discount_info",
          "min": 0,
          "max": 95,
          "step": 5,
          "unit": "%",
          "default": 0
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:focusable.calculator.name",
      "category": "t:focusable.common.category",
      "blocks": [
        { "type": "posture", "settings": { "short_label": "None", "label": "None / No Statement", "discount": 0 } },
        { "type": "posture", "settings": { "short_label": "Draft Statement", "label": "Draft Statement Published", "discount": 15 } },
        { "type": "posture", "settings": { "short_label": "Self-Assessed", "label": "WCAG Self-Assessment", "discount": 35 } },
        { "type": "posture", "settings": { "short_label": "Active Audit", "label": "Active WCAG Audit", "discount": 55 } }
      ]
    }
  ]
}
{% endschema %}
