{% render 'focusable-styles' %}
{% render 'pre-footer-cta', section: section %}

{% schema %}
{
  "name": "t:focusable.precta.name",
  "class": "fc-section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:focusable.common.eyebrow",
      "default": "// Final Check"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:focusable.common.heading",
      "default": "Secure Your Checkout. Protect Your Revenue."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:focusable.common.lede",
      "default": "Get a sprint-ready accessibility audit tailored for European e-commerce. Zero disruption to your dev cycle."
    },
    {
      "type": "header",
      "content": "t:focusable.common.cta_header"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:focusable.common.primary_label",
      "default": "Get Async Audit"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "t:focusable.common.primary_url"
    },
    {
      "type": "text",
      "id": "primary_note",
      "label": "t:focusable.common.primary_note",
      "default": "€500 · 48h · No calls. Just Jira tickets."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 128
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 128
    }
  ],
  "presets": [
    {
      "name": "t:focusable.precta.name",
      "category": "t:focusable.common.category"
    }
  ]
}
{% endschema %}
