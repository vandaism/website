{%- doc -%}
  Landing hero: badge, heading, description and CTA pair on the left; a static
  "verified report" card on the right built from `report_row` blocks.

  @param {object} section - The hero-compliance section (settings + blocks)
{%- enddoc -%}

{%- liquid
  assign s = section.settings
  assign heading_id = 'fc-hero-heading-' | append: section.id
  # newline_to_br output varies between <br /> and <br>; normalise before tagging the break
  assign heading_html = s.heading | escape | newline_to_br | replace: '<br />', '<br>' | replace: '<br>', '<br class="fc-hero__linebreak">'
-%}

<section
  class="fc-section fc-hero"
  aria-labelledby="{{ heading_id }}"
  style="{% render 'spacing-style', settings: s %}"
>
  <div class="fc-hero__texture" aria-hidden="true"></div>

  <div class="fc-container fc-hero__inner">
    <div class="fc-hero__grid">
      <div class="fc-hero__copy">
        {%- if s.badge_text != blank -%}
          <p class="fc-badge"><span class="fc-badge__dot" aria-hidden="true"></span>{{ s.badge_text | escape }}</p>
        {%- endif -%}

        <h1 class="fc-hero__heading" id="{{ heading_id }}">{{ heading_html }}</h1>

        {%- if s.description != blank -%}
          <p class="fc-hero__desc">{{ s.description | escape }}</p>
        {%- endif -%}

        {%- render 'focusable-cta-pair', settings: s, class: 'fc-hero__ctas' -%}
      </div>

      <div class="fc-report-frame">
        {%- render 'focusable-icon', icon: 'bracket-tl', class: 'fc-report-frame__bracket fc-report-frame__bracket--tl' -%}
        {%- render 'focusable-icon', icon: 'bracket-tr', class: 'fc-report-frame__bracket fc-report-frame__bracket--tr' -%}
        {%- render 'focusable-icon', icon: 'bracket-bl', class: 'fc-report-frame__bracket fc-report-frame__bracket--bl' -%}
        {%- render 'focusable-icon', icon: 'bracket-br', class: 'fc-report-frame__bracket fc-report-frame__bracket--br' -%}

        <article class="fc-report-card" aria-label="{{ s.report_title | escape }}">
          <div class="fc-report-card__top">
            <span class="fc-report-card__id">{{ s.report_id | escape }}</span>
            {%- if s.report_pill != blank -%}
              <span class="fc-report-card__pill">
                {%- render 'focusable-icon', icon: 'check' -%}
                {{ s.report_pill | escape }}
              </span>
            {%- endif -%}
          </div>

          <h2 class="fc-report-card__title">{{ s.report_title | escape }}</h2>
          {%- if s.report_subtitle != blank -%}
            <p class="fc-report-card__subtitle">{{ s.report_subtitle | escape }}</p>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <ul class="fc-report-card__list" role="list">
              {%- for block in section.blocks -%}
                <li class="fc-report-card__row" {{ block.shopify_attributes }}>
                  <span class="fc-report-card__row-left">
                    <span class="fc-report-card__check">{%- render 'focusable-icon', icon: 'check' -%}</span>
                    <span class="fc-report-card__row-label">{{ block.settings.label | escape }}</span>
                  </span>
                  {%- if block.settings.ticket != blank -%}
                    <span class="fc-report-card__row-ticket">{{ block.settings.ticket | escape }}</span>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if s.summary_label != blank -%}
            <p class="fc-report-card__summary">
              <span class="fc-report-card__summary-label">{{ s.summary_label | escape }}</span>
              <span class="fc-report-card__summary-value fc-tnum">{{ s.summary_value | escape }}</span>
            </p>
          {%- endif -%}
        </article>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .fc-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--fc-slate-50) 0%, var(--fc-white) 55%);
  }

  .fc-hero__texture {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(15, 23, 42, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(15, 23, 42, 0.05) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 92%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 92%);
  }

  .fc-hero__inner {
    position: relative;
    z-index: 1;
    padding-block: var(--padding-block-start, 88px) var(--padding-block-end, 96px);
  }

  .fc-hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }

  .fc-hero__heading {
    margin: 22px 0 0;
    font-size: 2.5rem;
    line-height: 1.18;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--fc-slate-900);
    text-wrap: normal;
    max-width: none;
  }

  .fc-hero__desc {
    margin: 24px 0 0;
    font-size: 18px;
    color: var(--fc-slate-600);
    line-height: 1.7;
    max-width: 46ch;
  }

  .fc-hero__ctas {
    margin-top: 34px;
  }

  /* ---------- Report card ---------- */
  .fc-report-frame {
    position: relative;
    max-width: 420px;
    width: 100%;
    margin-inline: auto;
  }

  .fc-report-frame__bracket {
    position: absolute;
    width: 30px;
    height: 30px;
    color: var(--fc-slate-300);
    pointer-events: none;
  }

  .fc-report-frame__bracket--tl { top: -14px; left: -14px; }
  .fc-report-frame__bracket--tr { top: -14px; right: -14px; }
  .fc-report-frame__bracket--bl { bottom: -14px; left: -14px; }
  .fc-report-frame__bracket--br { bottom: -14px; right: -14px; }

  .fc-report-card {
    background: var(--fc-white);
    border: 1px solid var(--fc-slate-200);
    border-radius: var(--fc-radius-xl);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 8px 24px -12px rgba(15, 23, 42, 0.1);
    padding: 26px;
  }

  .fc-report-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .fc-report-card__id {
    font-family: var(--fc-font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--fc-slate-500); /* was slate-400 (2.98:1); lifted to AA */
  }

  .fc-report-card__pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--fc-emerald-50);
    color: var(--fc-emerald-700);
    border-radius: 999px;
    padding: 5px 11px;
    font-size: 12px;
    font-weight: 600;
  }

  .fc-report-card__title {
    margin: 14px 0 0;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--fc-slate-900);
  }

  .fc-report-card__subtitle {
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--fc-slate-500);
  }

  .fc-report-card__list {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    border-top: 1px solid var(--fc-slate-100);
  }

  .fc-report-card__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 0;
    border-bottom: 1px solid var(--fc-slate-100);
  }

  .fc-report-card__row:last-child {
    border-bottom: none;
  }

  .fc-report-card__row-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .fc-report-card__check {
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: var(--fc-emerald-50);
    color: var(--fc-emerald-600);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .fc-report-card__row-label {
    font-size: 13.5px;
    color: var(--fc-slate-700);
  }

  .fc-report-card__row-ticket {
    font-family: var(--fc-font-mono);
    font-size: 11px;
    color: var(--fc-slate-500); /* was slate-400; lifted to AA */
  }

  .fc-report-card__summary {
    margin: 18px 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: var(--fc-slate-50);
    border: 1px solid var(--fc-slate-100);
    border-radius: var(--fc-radius-md);
    padding: 12px 16px;
  }

  .fc-report-card__summary-label {
    font-size: 12.5px;
    color: var(--fc-slate-500);
  }

  .fc-report-card__summary-value {
    font-family: var(--fc-font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--fc-slate-900);
  }

  @media (max-width: 960px) {
    .fc-hero__grid {
      grid-template-columns: 1fr;
    }

    .fc-hero__heading {
      font-size: 2.1rem;
      letter-spacing: -0.02em;
    }

    .fc-hero__linebreak {
      display: none;
    }
  }
{% endstylesheet %}
